<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
    <div :if={assigns[:online_count]} id="online-counter" class="online-counter">
      <span class="online-dot"></span>
      {gettext("Online: %{count}", count: @online_count)}
    </div>
  </div>
</main>
