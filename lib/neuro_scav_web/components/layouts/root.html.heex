<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=no, maximum-scale=1, viewport-fit=cover"
    />
    <meta name="description" content="Scavenger's names generator." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ScavGen" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#000000" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="scavgen">
      {assigns[:page_title]}
    </.live_title>
    <%!-- without preload the navbar is laid out in the fallback font first and jumps on every page load --%>
    <link rel="preload" href={~p"/fonts/Bender.otf"} as="font" type="font/otf" crossorigin />
    <link
      rel="preload"
      href={~p"/fonts/SFProText-Regular.ttf"}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <Turnstile.script />
  </head>
  <body
    style="background-color: black;"
    class={"#{if @live_action in [:single_scavenger, :team_scavengers, :statistics, :glossary, :wheel, :check_name, :collection, :battle], do: "scav-old-back", else: "scav-back"}"}
  >
    <div class="background-container">
      <div class="container container-nav">
        <nav class="navbar navbar-expand navbar-light navbar-scav">
          <div class="collapse navbar-collapse show">
            <div class="navbar-nav">
              <.nav_menu action={@live_action} />
              <.navlink path={~p"/neuro_scavengers"} action={@live_action}>
                {gettext("Neuro-scav")}
              </.navlink>
            </div>
          </div>
          <div class="navbar navbar-expand navbar-light navbar-right">
            <div class="collapse navbar-collapse show">
              <div class="navbar-nav">
                <.locale_link
                  lang={@conn.params["lang"] || @conn.cookies["lang"]}
                  path={@conn.request_path}
                  action={@live_action}
                ></.locale_link>
              </div>
            </div>
          </div>
        </nav>
      </div>
      {@inner_content}
    </div>
    <footer id="gnomeFooter" class="gnome-footer">
      <div class="gnome-container">
        <img
          id="gnomeImage"
          src="/images/gnome.png"
          alt="Gnome"
          class="gnome-image"
          phx-click="gnome_clicked"
          phx-throttle="2000"
        />
        <p class="gnome-text">{gettext("Gnome click")}</p>
      </div>
    </footer>

    <div id="rarity-flash" class="rarity-flash"></div>

    <button
      id="shortcuts-help-btn"
      class="shortcuts-help-btn"
      onclick="window.toggleShortcutsModal()"
    >
      ?
    </button>

    <div
      id="shortcuts-modal"
      class="shortcuts-modal hidden"
      onclick="if(event.target===this)window.toggleShortcutsModal()"
    >
      <div class="shortcuts-modal-content">
        <div class="shortcuts-modal-header">
          <span>{gettext("Keyboard Shortcuts")}</span>
          <button onclick="window.toggleShortcutsModal()" class="shortcuts-modal-close">
            X
          </button>
        </div>
        <div class="shortcuts-modal-body">
          <table class="shortcuts-table">
            <tbody>
              <tr>
                <td><kbd>Space</kbd></td>
                <td>{gettext("Shortcut generate")}</td>
              </tr>
              <tr>
                <td><kbd>1</kbd></td>
                <td>{gettext("Single")}</td>
              </tr>
              <tr>
                <td><kbd>2</kbd></td>
                <td>{gettext("Team")}</td>
              </tr>
              <tr>
                <td><kbd>3</kbd></td>
                <td>{gettext("Neuro-scav")}</td>
              </tr>
              <tr>
                <td><kbd>4</kbd></td>
                <td>{gettext("Stats")}</td>
              </tr>
              <tr>
                <td><kbd>5</kbd></td>
                <td>{gettext("Wheel")}</td>
              </tr>
              <tr>
                <td><kbd>6</kbd></td>
                <td>{gettext("Name check")}</td>
              </tr>
              <tr>
                <td><kbd>7</kbd></td>
                <td>{gettext("Collection")}</td>
              </tr>
              <tr>
                <td><kbd>8</kbd></td>
                <td>{gettext("Battle")}</td>
              </tr>
              <tr>
                <td><kbd>?</kbd></td>
                <td>{gettext("Shortcut toggle help")}</td>
              </tr>
              <tr>
                <td><kbd>Esc</kbd></td>
                <td>{gettext("Shortcut close modal")}</td>
              </tr>
            </tbody>
          </table>
          <div class="shortcuts-modal-glossary">
            <a href={~p"/glossary"} class="glossary-modal-link">
              {gettext("Glossary link")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
