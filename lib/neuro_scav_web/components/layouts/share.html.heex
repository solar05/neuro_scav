<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <%= if assigns[:name] do %>
      <title>{@name} — {@rarity} | scavgen</title>
      <meta name="description" content={"I found a #{@rarity} scavenger: #{@name}"} />
      <meta property="og:site_name" content="ScavGen" />
      <meta property="og:title" content={"#{@name} — #{@rarity}"} />
      <meta property="og:description" content={"A #{@rarity} scavenger from scavgen"} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={url(~p"/share/#{@token}")} />
      <meta property="og:image" content={url(~p"/share/#{@token}/image")} />
      <meta property="og:image:secure_url" content={url(~p"/share/#{@token}/image")} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={"#{@name} — #{@rarity} scavenger"} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={"#{@name} — #{@rarity}"} />
      <meta name="twitter:description" content={"A #{@rarity} scavenger from scavgen"} />
      <meta name="twitter:image" content={url(~p"/share/#{@token}/image")} />
    <% else %>
      <title>scavgen</title>
    <% end %>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body style="background-color: black; margin: 0;">
    {@inner_content}
  </body>
</html>
