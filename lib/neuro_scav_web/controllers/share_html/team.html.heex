<div class={["share-page share-map-page", @location_class]}>
  <p class="share-region">{gettext("Share region")}</p>
  <div class="share-card-wrap" style={"--rc: #{@border_color}; --rc-glow: transparent"}>
    <span class="cb cb-tl"></span>
    <span class="cb cb-tr"></span>
    <span class="cb cb-bl"></span>
    <span class="cb cb-br"></span>
    <div class="share-card share-team-card">
      <div class={"share-card-art share-team-art share-art-#{@art}"}></div>
      <ol class="share-team-list">
        <li :for={member <- @members} class="share-team-row" style={"--mc: #{member.color}"}>
          <span class="share-team-name">{member.name}</span>
          <span class="share-team-rarity">{member.rarity}</span>
        </li>
      </ol>
      <div class="share-card-footer">
        <span class="share-brand">scavgen</span>
      </div>
    </div>
  </div>

  <div class="share-actions">
    <button
      class="share-copy-btn"
      data-url={url(~p"/share/team/#{@token}")}
      onclick={share_js()}
    >
      copy link
    </button>
    <a href={~p"/team_scavengers"} class="share-try-btn">try yourself</a>
  </div>
</div>
