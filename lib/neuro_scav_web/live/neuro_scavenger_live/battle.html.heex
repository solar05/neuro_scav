<div class="container pt-2">
  <h2 class="text-center blended-reg-bg scav-container">{gettext("Battle title")}</h2>

  <div :if={is_nil(@room_id)} class="battle-lobby">
    <p class="battle-note">{gettext("Battle rules")}</p>
    <div class="battle-size">
      <button
        :for={mode <- [:duel, :team, :draft]}
        id={"btn-battle-mode-#{mode}"}
        class={[
          "btn btn-lg",
          if(mode == @mode, do: "btn-old-blended blended", else: "blend-old-font")
        ]}
        phx-click="mode"
        phx-value-mode={mode}
      >
        {mode_label(mode)}
      </button>
    </div>
    <p :if={mode_rules(@mode)} class="battle-note">{mode_rules(@mode)}</p>
    <p class="battle-note">{gettext("Anomaly rules")}</p>
    <p class="battle-note">
      {gettext("Turn timer rules %{seconds}", seconds: NeuroScav.BattleRoom.turn_seconds())}
    </p>
    <button
      id="btn-battle-find"
      class="btn btn-old-blended btn-lg blended w-100"
      phx-click="find"
      phx-throttle="1000"
    >
      {gettext("Find opponent")}
    </button>
    <button
      id="btn-battle-create"
      class="btn blend-old-font btn-lg w-100 mt-3"
      phx-click="create"
      phx-throttle="1000"
    >
      {gettext("Create battle")}
    </button>
    <button
      id="btn-battle-bot"
      class="btn blend-old-font btn-lg w-100 mt-3"
      phx-click="create_bot"
      phx-throttle="1000"
    >
      {gettext("Play with bot")}
    </button>
  </div>

  <div :if={@closed} class="battle-lobby">
    <p class="battle-note">{gettext("Battle not found")}</p>
    <.link navigate={~p"/battle"} class="btn btn-old-blended btn-lg blended w-100">
      {gettext("Create new battle")}
    </.link>
  </div>

  <%!-- every part keeps its size through the battle, so nothing jumps:
       the result and the note share one cell, unknown cards are placeholders,
       the action row has one height and ends with the rematch button --%>
  <div
    :if={@battle}
    id="battle"
    class={[@battle.anomaly && "anomaly-#{@battle.anomaly}", @battle.result && "battle-over"]}
    style={reveal_style(@battle)}
  >
    <%!-- a new anomaly is a new element, so the banner plays its entrance again --%>
    <div :if={@battle.anomaly} id={"battle-anomaly-#{@battle.anomaly}"} class="anomaly-banner">
      <span class="anomaly-icon" aria-hidden="true">{anomaly_icon(@battle.anomaly)}</span>
      <div>
        <p class="anomaly-name">{gettext("Anomaly")}: {anomaly_name(@battle.anomaly)}</p>
        <p class="anomaly-rule">{anomaly_rule(@battle.anomaly)}</p>
      </div>
    </div>

    <div class="battle-status">
      <p class={[
        "battle-result",
        if(@battle.result, do: "battle-reveal-end", else: "battle-hidden")
      ]}>
        {result_text(@battle, @user_id)}
      </p>
      <div class={@battle.result && "battle-hidden"}>
        <%= cond do %>
          <% not player?(@battle, @user_id) -> %>
            <p class="battle-note">{gettext("Spectator")}</p>
          <% length(@battle.players) == 1 -> %>
            <p class="battle-note">
              {if @battle.open,
                do: gettext("Searching opponent"),
                else: gettext("Send invite hint")}
            </p>
            <.share_button path={~p"/battle/#{@battle.id}"} label={gettext("Copy invite")} />
          <% @battle.draft -> %>
            <p class="battle-note">{draft_note(@battle, @user_id)}</p>
          <% true -> %>
            <p class="battle-note">{gettext("Battle rules short")}</p>
        <% end %>
      </div>
    </div>

    <%!-- the time left for a move; the track stays, so nothing jumps when it stops --%>
    <div class="battle-timer" title={gettext("Time to move")}>
      <span
        :if={@battle.deadline}
        id={"battle-timer-#{@battle.deadline}"}
        style={timer_style(@battle)}
      ></span>
    </div>

    <%!-- the draft table: open cards, a click takes one on your turn --%>
    <div :if={@battle.draft && is_nil(@battle.result)} id="draft-pool" class="draft-pool">
      <button
        :for={{card, index} <- Enum.with_index(@battle.draft.pool)}
        id={"draft-card-#{index}"}
        class="battle-card draft-card"
        phx-click="pick"
        phx-value-index={index}
        phx-throttle="500"
        disabled={not my_turn?(@battle, @user_id)}
      >
        <div class={"battle-card-name #{card.rarity}-name"}>{card.name}</div>
        <p class={"battle-card-rarity #{card.rarity}"}>{rarity_text(card.rarity)}</p>
        <.card_stats card={card} hidden={in_the_dark?(@battle)} />
      </button>
    </div>

    <p
      :if={length(@battle.players) == 2}
      id="battle-series"
      class={["battle-note", @battle.result && "battle-reveal-end"]}
    >
      {gettext("Series %{score}", score: series(@battle, @user_id))}
    </p>

    <div class="battle-arena">
      <div
        :for={seat <- seats(@battle, @user_id)}
        class={["wheel-panel battle-seat", seat.outcome && "battle-seat-#{seat.outcome}"]}
      >
        <div class="wheel-panel-header">
          <span>{seat.label}</span>
          <span
            :if={msg = seat.player && bubble(@battle, seat.player, @user_id, @muted)}
            id={"battle-bubble-#{msg.id}"}
            class="battle-bubble"
          >
            {chat_text(msg)}
          </span>
          <span :if={seat.score_steps} class="wheel-panel-count battle-score">
            <span :for={{score, round} <- seat.score_steps} style={"--round: #{round}"}>
              {score}
            </span>
          </span>
        </div>
        <div class={["battle-seat-body", @battle.size > 1 && "battle-team"]}>
          <div
            :for={{card, slot} <- Enum.with_index(pad(seat.cards, @battle.size))}
            class="battle-card"
          >
            <%= if card do %>
              <div class={"battle-card-name #{card.rarity}-name"}>
                <span
                  id={"battle-card-#{seat.index}-#{slot}"}
                  phx-hook="ScavName"
                >
                  {card.name}
                </span>
              </div>
              <p class={"battle-card-rarity #{card.rarity}"}>
                {rarity_text(card.rarity)}
              </p>
              <.card_stats
                card={card}
                won={card.won}
                first_round={slot * length(NeuroScav.BattleRoom.stats())}
                hidden={in_the_dark?(@battle)}
              />
            <% else %>
              <%!-- no id or hook: the real card replaces it and plays its reveal --%>
              <div class="battle-card-name battle-card-unknown"><span>?</span></div>
              <p class="battle-card-rarity">&nbsp;</p>
              <ul class="battle-stats">
                <li :for={stat <- NeuroScav.BattleRoom.stats()} class="battle-stat">
                  <span>{stat_label(stat)}</span>
                  <span class="battle-stat-bar"></span>
                  <b>?</b>
                </li>
              </ul>
            <% end %>
          </div>

          <p :if={seat.sets not in [nil, []]} class="battle-sets">
            <span :for={set <- seat.sets} class="battle-set">
              {set_label(set)} +{NeuroScav.BattleRoom.set_bonus()}
            </span>
          </p>

          <div class="battle-actions">
            <%= cond do %>
              <% @battle.result -> %>
                <%= case result_action(@battle, seat, @user_id) do %>
                  <% :rematch -> %>
                    <button
                      id="btn-battle-rematch"
                      class="btn btn-old-blended blended battle-reveal-end"
                      phx-click="rematch"
                      phx-throttle="1000"
                    >
                      {if rematch_offered?(@battle, @user_id),
                        do: gettext("Accept rematch"),
                        else: gettext("Rematch")}
                    </button>
                  <% :alone -> %>
                    <button
                      id="btn-battle-bot-again"
                      class="btn btn-old-blended blended battle-reveal-end"
                      phx-click="create_bot"
                      phx-throttle="1000"
                    >
                      {gettext("Play with bot")}
                    </button>
                    <.link
                      id="btn-battle-lobby"
                      navigate={~p"/battle"}
                      class="btn blend-old-font battle-reveal-end"
                    >
                      {gettext("To lobby")}
                    </.link>
                  <% :asked -> %>
                    <p id={"battle-rematch-#{seat.index}"} class="battle-wait">
                      {gettext("Rematch asked")}
                    </p>
                  <% :wants -> %>
                    <p id={"battle-rematch-#{seat.index}"} class="battle-wait">
                      {gettext("Wants rematch")}
                    </p>
                  <% :away -> %>
                    <p class="battle-wait">{gettext("Left the battle")}</p>
                  <% nil -> %>
                <% end %>
              <% seat.own? -> %>
                <button
                  :if={seat.can_draw?}
                  id="btn-battle-draw"
                  class="btn btn-old-blended blended"
                  phx-click="draw"
                  phx-throttle="1000"
                >
                  <%= cond do %>
                    <% seat.cards -> %>
                      {gettext("Redraw")}
                    <% @battle.size > 1 -> %>
                      {gettext("Draw team")}
                    <% true -> %>
                      {gettext("Draw card")}
                  <% end %>
                </button>
                <button
                  :if={seat.can_fight?}
                  id="btn-battle-ready"
                  class="btn btn-old-blended blended"
                  phx-click="ready"
                  phx-throttle="1000"
                >
                  {gettext("Fight")}
                </button>
                <p :if={seat.ready?} class="battle-wait">{gettext("Waiting for opponent")}</p>
              <% true -> %>
                <p class="battle-wait">{seat_status(@battle, seat)}</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- the log and the text box are for big screens (CSS hides them on touch
         devices), phrases work everywhere and every message also pops up as a
         bubble over its seat; spectators only read --%>
    <div
      :if={length(@battle.players) == 2}
      id="battle-chat"
      class={["wheel-panel battle-chat", not player?(@battle, @user_id) && "battle-chat-readonly"]}
    >
      <div class="wheel-panel-header">
        <span>{gettext("Chat")}</span>
        <button
          :if={player?(@battle, @user_id)}
          id="btn-chat-mute"
          type="button"
          class="battle-chat-mute"
          phx-click="mute"
        >
          {if @muted, do: gettext("Unmute"), else: gettext("Mute")}
        </button>
      </div>
      <%!-- column-reverse keeps the newest message in view without any JS --%>
      <ol id="battle-chat-log" class="battle-chat-log">
        <li :for={msg <- Enum.reverse(chat(@battle, @user_id, @muted))} id={"chat-#{msg.id}"}>
          <b>{seat_label(@battle, msg.from, @user_id)}:</b> {chat_text(msg)}
        </li>
      </ol>
      <div :if={player?(@battle, @user_id)} class="battle-chat-phrases">
        <button
          :for={phrase <- NeuroScav.BattleRoom.phrases()}
          id={"chat-phrase-#{phrase}"}
          type="button"
          class="suggest-chip"
          phx-click="say_phrase"
          phx-value-phrase={phrase}
          phx-throttle="1000"
        >
          {phrase_text(phrase)}
        </button>
      </div>
      <%!-- the reset waits a tick: LiveView reads the text on the same submit --%>
      <form
        :if={player?(@battle, @user_id)}
        id="battle-chat-form"
        class="battle-chat-form"
        phx-submit="say"
        onsubmit="setTimeout(() => this.reset())"
      >
        <input
          name="text"
          maxlength="200"
          autocomplete="off"
          placeholder={gettext("Chat placeholder")}
        />
        <button class="btn btn-old-blended blended">{gettext("Send")}</button>
      </form>
    </div>
  </div>
</div>
