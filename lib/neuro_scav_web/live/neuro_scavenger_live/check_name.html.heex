<div class="container pt-2">
  <h2 class={"text-center blended-reg-bg scav-container #{@scavenger.rarity}-name"}>
    <span id="scav-name" phx-hook="ScavName">{@scavenger.name}</span>
  </h2>
  <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap mt-3">
    <h3 class={"blended-reg-bg rarity-label #{@scavenger.rarity} mb-0"}>
      {@scavenger.rarity_text}
    </h3>
  </div>
  <div :if={@card} id="check-name-card" class="wheel-panel check-name-card">
    <div class="wheel-panel-header">
      <span>{gettext("Battle card")}</span>
    </div>
    <.card_stats card={@card} />
  </div>
  <div class="wheel-panel check-name-panel">
    <div class="wheel-panel-header">
      <span>{gettext("Check name hint")}</span>
    </div>
    <.form for={%{}} id="check-name-form" class="check-name-form" phx-submit="check_name">
      <.input
        name="name"
        value=""
        maxlength="40"
        required
        autofocus
        autocomplete="off"
        autocapitalize="words"
        placeholder={gettext("Check name placeholder")}
      />
      <button class="btn btn-old-blended blended">{gettext("Check name")}</button>
    </.form>
    <div :if={@suggestions} id="name-suggestions" class="name-suggestions">
      <p class="name-suggestions-title">
        {gettext("Last names for %{name}", name: @suggestions.first)}
      </p>
      <p :if={@suggestions.groups == []} class="name-suggestions-title">
        {gettext("No suggestions")}
      </p>
      <div :for={{rarity, names} <- @suggestions.groups} class={"suggest-row suggest-#{rarity}"}>
        <span class="suggest-label">{rarity_label(rarity)}</span>
        <button
          :for={name <- names}
          type="button"
          class="suggest-chip"
          phx-click={
            JS.push("check_name", value: %{name: name})
            |> JS.dispatch("scav:reveal", to: "#scav-name")
          }
        >
          {name}
        </button>
      </div>
    </div>
  </div>
  <.share_button :if={@scavenger.rarity} name={@scavenger.name} rarity={@scavenger.rarity} />
</div>
