<div id="collection" class="container pt-2" phx-hook="Collection">
  <h2 class="text-center blended-reg-bg scav-container">{gettext("Collection title")}</h2>
  <p class="collection-progress">{MapSet.size(@found)} / {length(@legendaries)}</p>
  <p :if={MapSet.size(@found) == 0} class="collection-hint">{gettext("Collection hint")}</p>
  <div class="collection-grid">
    <div
      :for={name <- @legendaries}
      class={["collection-card", MapSet.member?(@found, name) && "collection-card-found"]}
    >
      {if MapSet.member?(@found, name), do: name, else: mask(name)}
    </div>
  </div>
</div>
