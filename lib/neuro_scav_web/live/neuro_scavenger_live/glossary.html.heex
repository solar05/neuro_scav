<div class="container pt-2">
  <h2 class="text-center blended-reg-bg mb-4">{gettext("Rarity Guide")}</h2>
  <table class="table table-responsive table-scav table-hover">
    <tbody>
      <tr>
        <td class="td-scav" style="border-radius: 10px 0px 0px 0px; width: 36%;">
          <span class="text-container neuro">{gettext("Stats neuro")}</span>
        </td>
        <td class="td-scav-desc" style="border-radius: 0px 10px 0px 0px;">
          {gettext("neuro rule")}
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container legendary">{gettext("Stats legendary")}</span>
        </td>
        <td class="td-scav-desc">
          {gettext("legendary rule")}
          <br /><small class="glossary-example">{gettext("legendary examples")}</small>
          <br />
          <small class="glossary-chance">
            {gettext("Chance")}: {chance(@odds, :legendary)}
          </small>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container epic">{gettext("Stats epic")}</span>
        </td>
        <td class="td-scav-desc">
          {gettext("epic rule")}
          <br /><small class="glossary-example">{gettext("epic examples")}</small>
          <br /><small class="glossary-chance">{gettext("Chance")}: {chance(@odds, :epic)}</small>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container rare">{gettext("Stats rare")}</span>
        </td>
        <td class="td-scav-desc">
          {gettext("rare rule")}
          <br /><small class="glossary-example">{gettext("rare examples")}</small>
          <br /><small class="glossary-chance">{gettext("Chance")}: {chance(@odds, :rare)}</small>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container uncommon">{gettext("Stats uncommon")}</span>
        </td>
        <td class="td-scav-desc">
          {gettext("uncommon rule")}
          <br /><small class="glossary-example">{gettext("uncommon examples")}</small>
          <br />
          <small class="glossary-chance">
            {gettext("Chance")}: {chance(@odds, :uncommon)}
          </small>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container common">{gettext("Stats common")}</span>
        </td>
        <td class="td-scav-desc">
          {gettext("common rule")}
          <br />
          <small class="glossary-chance">
            {gettext("Chance")}: {chance(@odds, :common)}
          </small>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="border-radius: 0px 0px 0px 10px; border-bottom: none;">
          <span class="text-container gnome">{gettext("Stats gnome")}</span>
        </td>
        <td class="td-scav-desc" style="border-radius: 0px 0px 10px 0px; border-bottom: none;">
          {gettext("gnome rule")}
          <br />
          <small class="glossary-chance">
            {gettext("Chance")}: {chance(@odds, :gnome)}
          </small>
        </td>
      </tr>
    </tbody>
  </table>
</div>
