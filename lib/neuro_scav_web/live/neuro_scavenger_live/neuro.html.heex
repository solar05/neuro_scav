<div class="container pt-2">
  <h2 class={"text-center blended-reg-bg scav-container #{@neuro_scavenger.rarity}-name"}>
    <span id="neuro-scav-name" phx-hook="ScavName">{@neuro_scavenger.name}</span>
  </h2>
  <p class="lead mt-3">
    <.form for={%{}} phx-submit="schedule_request" id="neuro_form">
      <.button
        phx-debounce="500"
        phx-throttle="500"
        class="btn btn-blended-neuro btn-lg blended d-flex justify-content-center"
        style="width: 100%;"
        id="neuroButton"
        disabled
      >
        {gettext("Generate neuro")}
      </.button>
      <div style="margin-top: 20px; padding: 0; width: 100%; display: flex; align-items: center; gap: 12px;">
        <Turnstile.widget
          theme="dark"
          data-size="flexible"
          class="cf-turnstile"
          appearance="always"
          style="flex: 1;"
          button-id="neuroButton"
        />
        <div
          class="d-none d-md-flex"
          style="align-items: center; gap: 6px; white-space: nowrap; color: #ccc; font-size: 60px;"
        >
          <span style="font-size: 60px;">←</span>
          <span>{gettext("Neuro captcha")}</span>
        </div>
      </div>
    </.form>
  </p>
  <.share_button
    :if={@neuro_scavenger.rarity == "neuro"}
    name={@neuro_scavenger.name}
    rarity="neuro"
    class="btn-blended-neuro"
  />
  <script>
    document.getElementById('neuro_form').addEventListener('submit', function() {
      document.getElementById('neuroButton').disabled = true;
    });
  </script>
</div>
