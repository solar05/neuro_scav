<div class="container" style="margin-top: 20px;">
  <h1 class="display-4 text-center blended"></h1>
  <h2 class="text-center blended-reg-bg">{@neuro_scavenger}</h2>
  <br />
  <p class="lead">
    <.form for={%{}} phx-submit="schedule_request" id="neuro_form">
      <.button
        phx-debounce="500"
        phx-throttle="500"
        class="btn btn-blended-neuro btn-lg blended d-flex justify-content-center"
        style="width: 100%;"
        id="neuroButton"
        disabled
      >
        {gettext("Generate neuro")}
      </.button>
      <div style="margin-top: 20px; padding: 0; width: 100%; display: flex; align-items: center; gap: 12px;">
        <Turnstile.widget
          theme="dark"
          data-size="flexible"
          class="cf-turnstile"
          appearance="always"
          style="flex: 1;"
        />
        <div
          class="d-none d-md-flex"
          style="align-items: center; gap: 6px; white-space: nowrap; color: #ccc; font-size: 60px;"
        >
          <span style="font-size: 60px;">←</span>
          <span>{gettext("Neuro captcha")}</span>
        </div>
      </div>
    </.form>
  </p>
  <script>
    const button = document.getElementById('neuroButton')
    setTimeout(() => {
      button.disabled = false
    }, 2000)
  </script>
</div>
