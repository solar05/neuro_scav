<div class="container pt-2">
  <h2 class="text-center blended-reg-bg scav-container">{gettext("Quiz")}</h2>
  <p id="quiz-score" class="battle-note">
    {gettext("Quiz score %{right} %{total}", right: @right, total: @total)}
  </p>

  <%= case @question do %>
    <% %{type: :rarity} -> %>
      <p class="battle-note">{gettext("Quiz rarity question")}</p>
      <h2 class={"text-center blended-reg-bg scav-container #{@answer && @question.rarity}-name"}>
        <span id="quiz-name">{@question.name}</span>
      </h2>
      <div class="quiz-options">
        <button
          :for={rarity <- @rarities}
          id={"quiz-answer-#{rarity}"}
          class={[
            "suggest-chip suggest-#{rarity}",
            answer_class(@question, @answer, Atom.to_string(rarity))
          ]}
          phx-click="answer"
          phx-value-answer={rarity}
          disabled={@answer != nil}
        >
          {rarity_label(rarity)}
        </button>
      </div>
      <p :if={@answer} class="battle-note">{rarity_rule(@question.rarity)}</p>
    <% %{type: :duel} -> %>
      <p class="battle-note">{gettext("Quiz duel question")}</p>
      <div class="battle-arena">
        <button
          :for={{card, side} <- Enum.with_index(@question.cards)}
          id={"quiz-card-#{side}"}
          class={[
            "wheel-panel battle-seat quiz-card",
            answer_class(@question, @answer, Integer.to_string(side))
          ]}
          phx-click="answer"
          phx-value-answer={side}
          disabled={@answer != nil}
        >
          <div class="battle-seat-body">
            <div class={"battle-card-name #{@answer && card.rarity}-name"}>{card.name}</div>
            <%= if @answer do %>
              <p class={"battle-card-rarity #{card.rarity}"}>{rarity_text(card.rarity)}</p>
              <.card_stats card={card} won={Enum.at(@question.won, side)} />
            <% end %>
          </div>
        </button>
      </div>
    <% nil -> %>
  <% end %>

  <%= if @answer do %>
    <p class="battle-result">
      {if right?(@question, @answer), do: gettext("Quiz right"), else: gettext("Quiz wrong")}
    </p>
    <button
      id="btn-quiz-next"
      class="btn btn-old-blended btn-lg blended w-100"
      phx-click="next"
      phx-throttle="300"
    >
      {gettext("Next")}
    </button>
  <% end %>
</div>
