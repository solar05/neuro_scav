<div class="container">
  <h1 class="display-4 text-center blended"></h1>
  <h2 class={"text-center blended-reg-bg scav-container #{@scavenger.rarity}-name"}>
    <span id="scav-name" phx-hook="ScavName">{@scavenger.name}</span>
  </h2>
  <br />
  <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
    <h3 class={"blended-reg-bg scav-container #{@scavenger.rarity} mb-0"}>
      {@scavenger.rarity_text}
    </h3>
    <%= if @streak >= 2 do %>
      <div class={"streak-badge #{@streak_class}"}>
        x{@streak}
      </div>
    <% end %>
  </div>
  <br />
  <p class="lead">
    <.link
      phx-click="generate_single"
      phx-throttle="500"
      id="btn-single"
      class="btn btn-old-blended btn-lg blended d-flex justify-content-center"
    >
      {gettext("Generate single")}
    </.link>
  </p>
</div>
