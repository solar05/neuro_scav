<div class="container pt-2">
  <h2 class={"text-center blended-reg-bg scav-container #{@scavenger.rarity}-name"}>
    <span id="scav-name" phx-hook="ScavName">{@scavenger.name}</span>
  </h2>
  <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap mt-3">
    <h3 class={"blended-reg-bg rarity-label #{@scavenger.rarity} mb-0"}>
      {@scavenger.rarity_text}
    </h3>
  </div>
  <p class="lead mt-3">
    <.link
      phx-click="generate_single"
      phx-throttle="500"
      id="btn-single"
      class="btn btn-old-blended btn-lg blended d-flex justify-content-center"
    >
      {gettext("Generate single")}
    </.link>
  </p>
  <%= if @share_token do %>
    <p class="lead mt-2">
      <button
        class="btn btn-old-blended btn-lg blended d-flex justify-content-center w-100"
        data-url={"/share/#{@share_token}"}
        onclick="var btn=this; var url=window.location.origin+btn.dataset.url; navigator.clipboard.writeText(url).then(function(){var orig=btn.textContent; btn.textContent='✓'; setTimeout(function(){btn.textContent=orig;},1500);});"
      >
        {gettext("Share")}
      </button>
    </p>
  <% end %>
</div>
