<div class="container">
  <table class="table table-responsive table-scav table-hover">
    <tbody>
      <tr>
        <td class="td-scav" style="border-radius: 10px 0px 0px 0px; text-align: center;">
          <span class="text-container neuro">{gettext("Stats neuro")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container neuro">{@statistics.neuro}</span>
        </td>
        <td class="td-scav" style="border-radius: 0px 10px 0px 0px; text-align: center;">
          <span class="text-container neuro">{calc_percent(@statistics.neuro, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container legendary">{gettext("Stats legendary")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container legendary">{@statistics.legendary}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container legendary">{calc_percent(@statistics.legendary, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container epic">{gettext("Stats epic")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container epic">{@statistics.epic}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container epic">{calc_percent(@statistics.epic, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container rare">{gettext("Stats rare")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container rare">{@statistics.rare}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container rare">{calc_percent(@statistics.rare, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container uncommon">{gettext("Stats uncommon")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container uncommon">{@statistics.uncommon}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container uncommon">{calc_percent(@statistics.uncommon, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container common">{gettext("Stats common")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container common">{@statistics.common}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container common">{calc_percent(@statistics.common, @total)}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container gnome">{gettext("Stats gnome")}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container gnome">{@statistics.gnome}</span>
        </td>
        <td class="td-scav" style="text-align: center;">
          <span class="text-container gnome">{calc_percent(@statistics.gnome, @total)}</span>
        </td>
      </tr>
      <tr>
        <td
          class="td-scav"
          style="border-radius: 0px 0px 0px 10px; text-align: center; border-bottom: none;"
        >
          <span class="text-container">{gettext("Stats total")}</span>
        </td>
        <td class="td-scav" style="text-align: center; border-bottom: none;">
          <span class="text-container">{@total}</span>
        </td>
        <td
          class="td-scav"
          style="border-radius: 0px 0px 10px 0px; border-bottom: none; text-align: center;"
        >
          <span class="text-container">100%</span>
        </td>
      </tr>
    </tbody>
  </table>
</div>
