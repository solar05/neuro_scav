<div class="container">
  <table class="table table-responsive table-scav table-hover">
    <tbody>
      <tr>
        <td class="td-scav" style="border-radius: 10px 0px 0px 0px;">
          <span class="text-container neuro">{gettext("Stats neuro")}</span>
        </td>
        <td class="td-scav" style="border-radius: 0px 10px 0px 0px;">
          <span class="text-container neuro">{@statistics.neuro}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container legendary">{gettext("Stats legendary")}</span>
        </td>
        <td class="td-scav">
          <span class="text-container legendary">{@statistics.legendary}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container epic">{gettext("Stats epic")}</span>
        </td>
        <td class="td-scav">
          <span class="text-container epic">{@statistics.epic}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container rare">{gettext("Stats rare")}</span>
        </td>
        <td class="td-scav">
          <span class="text-container rare">{@statistics.rare}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container uncommon">{gettext("Stats uncommon")}</span>
        </td>
        <td class="td-scav">
          <span class="text-container uncommon">{@statistics.uncommon}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav">
          <span class="text-container common">{gettext("Stats common")}</span>
        </td>
        <td class="td-scav">
          <span class="text-container common">{@statistics.common}</span>
        </td>
      </tr>
      <tr>
        <td class="td-scav" style="border-radius: 0px 0px 0px 10px; border-bottom: none;">
          <span class="text-container gnome">{gettext("Stats gnome")}</span>
        </td>
        <td class="td-scav" style="border-radius: 0px 0px 10px 0px; border-bottom: none;">
          <span class="text-container gnome">{@statistics.gnome}</span>
        </td>
      </tr>
    </tbody>
  </table>
</div>
