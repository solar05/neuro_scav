<div class="container">
  <table class="table table-responsive table-scav table-hover team-table">
    <tbody>
      <tr :for={{index, member} <- slots(@team)}>
        <td
          class={["td-scav", member && "team-slot", index in @locked && "team-slot-locked"]}
          style={slot_style(index)}
          phx-click={member && "toggle_lock"}
          phx-value-index={index}
        >
          <span class={"text-container team-#{member && member.rarity}-name"}>
            <span
              id={"team-name-#{index}"}
              phx-hook="ScavName"
              data-collect={gettext("Added to collection")}
            >
              {(member && member.name) || gettext("Single placeholder")}
            </span>
            <span :if={index in @locked} class="team-lock">🔒</span>
          </span>
        </td>
      </tr>
    </tbody>
  </table>
  <p :if={team_sets(@team) != []} id="team-sets" class="battle-sets">
    {gettext("Team sets")}:
    <span :for={set <- team_sets(@team)} class="battle-set">{set_label(set)}</span>
  </p>
  <p :if={@team != []} class="team-lock-hint">{gettext("Team lock hint")}</p>
  <p class="lead">
    <.link
      phx-click="generate_team"
      phx-throttle="500"
      id="btn-team"
      class="btn btn-old-blended btn-lg blended d-flex justify-content-center"
    >
      {gettext("Generate team")}
    </.link>
  </p>
  <.share_button :if={@team != []} team={@team} />
  <p :if={@team != []} class="lead mt-2">
    <.link
      id="btn-team-raid"
      navigate={NeuroScavWeb.NeuroScavengerLive.Raid.path(@team)}
      class="btn btn-old-blended btn-lg blended d-flex justify-content-center w-100"
    >
      {gettext("Go raid")}
    </.link>
  </p>
</div>
